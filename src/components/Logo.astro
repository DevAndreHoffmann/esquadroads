---
// PROVISÓRIO: marca tipográfica até recebermos o logo oficial da Esquadro ADS.
interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="logo" href={href}>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M5 3v24h24z" fill="#F2C230" />
    <path d="M10 14v8h8z" fill="#151412" />
    <path d="M5 8h3M5 13h2M5 18h3M5 23h2" stroke="#151412" stroke-width="1.4" />
  </svg>
  <span class="logo__word">Esquadro </span><span class="logo__ads">ADS</span><span class="visually-hidden">, página inicial</span>
</a>
